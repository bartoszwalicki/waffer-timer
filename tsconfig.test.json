{
  // Tests get node globals (readFileSync, process) that browser code must not
  // see, so they are their own project rather than widening tsconfig.app.json.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"],
  // `extends` also inherits the parent's exclude, which would cancel out the
  // include above.
  "exclude": []
}
